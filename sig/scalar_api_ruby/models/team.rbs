module Scalar
  module Models
    type team =
      {
        name: String,
        slug: String,
        theme: String,
        uid: String,
        image_uri: String
      }

    class Team < Scalar::Internal::Type::BaseModel
      attr_accessor name: String

      attr_accessor slug: String

      attr_accessor theme: String

      attr_accessor uid: String

      attr_reader image_uri: String?

      def image_uri=: (String) -> String

      def initialize: (
        name: String,
        slug: String,
        theme: String,
        uid: String,
        ?image_uri: String
      ) -> void

      def to_hash: -> {
        name: String,
        slug: String,
        theme: String,
        uid: String,
        image_uri: String
      }
    end
  end
end
