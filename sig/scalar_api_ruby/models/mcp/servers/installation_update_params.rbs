module Scalar
  module Models
    module Mcp
      module Servers
        type installation_update_params =
          {
            id: String,
            installation_id: String,
            mcp_version: String?,
            name: String,
            slug: String
          }
          & Scalar::Internal::Type::request_parameters

        class InstallationUpdateParams < Scalar::Internal::Type::BaseModel
          extend Scalar::Internal::Type::RequestParameters::Converter
          include Scalar::Internal::Type::RequestParameters

          attr_accessor id: String

          attr_accessor installation_id: String

          attr_accessor mcp_version: String?

          attr_reader name: String?

          def name=: (String) -> String

          attr_reader slug: String?

          def slug=: (String) -> String

          def initialize: (
            id: String,
            installation_id: String,
            ?mcp_version: String?,
            ?name: String,
            ?slug: String,
            ?request_options: Scalar::request_opts
          ) -> void

          def to_hash: -> {
            id: String,
            installation_id: String,
            mcp_version: String?,
            name: String,
            slug: String,
            request_options: Scalar::RequestOptions
          }
        end
      end
    end
  end
end
