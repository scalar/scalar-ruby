module Scalar
  module Models
    class McpServer = Mcp::McpServer

    module Mcp
      type mcp_server =
        {
          created_at: Integer,
          domain: String?,
          name: String,
          namespace: String,
          slug: String,
          uid: String,
          updated_at: Integer
        }

      class McpServer < Scalar::Internal::Type::BaseModel
        attr_accessor created_at: Integer

        attr_accessor domain: String?

        attr_accessor name: String

        attr_accessor namespace: String

        attr_accessor slug: String

        attr_accessor uid: String

        attr_accessor updated_at: Integer

        def initialize: (
          created_at: Integer,
          domain: String?,
          name: String,
          namespace: String,
          slug: String,
          uid: String,
          updated_at: Integer
        ) -> void

        def to_hash: -> {
          created_at: Integer,
          domain: String?,
          name: String,
          namespace: String,
          slug: String,
          uid: String,
          updated_at: Integer
        }
      end
    end
  end
end
