module Scalar
  module Models
    type login_portal = { slug: String, title: String, uid: String }

    class LoginPortal < Scalar::Internal::Type::BaseModel
      attr_accessor slug: String

      attr_accessor title: String

      attr_accessor uid: String

      def initialize: (slug: String, title: String, uid: String) -> void

      def to_hash: -> { slug: String, title: String, uid: String }
    end
  end
end
