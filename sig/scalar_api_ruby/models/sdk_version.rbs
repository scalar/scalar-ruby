module Scalar
  module Models
    type sdk_version =
      {
        created_at: Integer,
        languages: ::Array[Scalar::Models::SdkVersion::language],
        version: String
      }

    class SdkVersion < Scalar::Internal::Type::BaseModel
      attr_accessor created_at: Integer

      attr_accessor languages: ::Array[Scalar::Models::SdkVersion::language]

      attr_accessor version: String

      def initialize: (
        created_at: Integer,
        languages: ::Array[Scalar::Models::SdkVersion::language],
        version: String
      ) -> void

      def to_hash: -> {
        created_at: Integer,
        languages: ::Array[Scalar::Models::SdkVersion::language],
        version: String
      }

      type language =
        :typescript
        | :python
        | :cli
        | :csharp
        | :java
        | :ruby
        | :php
        | :go
        | :rust
        | :kotlin
        | :swift
        | :cpp
        | :dart

      module Language
        extend Scalar::Internal::Type::Enum

        TYPESCRIPT: :typescript
        PYTHON: :python
        CLI: :cli
        CSHARP: :csharp
        JAVA: :java
        RUBY: :ruby
        PHP: :php
        GO: :go
        RUST: :rust
        KOTLIN: :kotlin
        SWIFT: :swift
        CPP: :cpp
        DART: :dart

        def self?.values: -> ::Array[Scalar::Models::SdkVersion::language]
      end
    end
  end
end
