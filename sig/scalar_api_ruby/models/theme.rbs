module Scalar
  module Models
    type theme =
      { description: String, name: String, slug: String, uid: String }

    class Theme < Scalar::Internal::Type::BaseModel
      attr_accessor description: String

      attr_accessor name: String

      attr_accessor slug: String

      attr_accessor uid: String

      def initialize: (
        description: String,
        name: String,
        slug: String,
        uid: String
      ) -> void

      def to_hash: -> {
        description: String,
        name: String,
        slug: String,
        uid: String
      }
    end
  end
end
