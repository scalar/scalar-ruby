module Scalar
  module Resources
    class Mcp
      class Servers
        class Installations
          def create: (
            String id,
            document_auth: ::Hash[Symbol, top],
            name: String,
            ?slug: String,
            ?request_options: Scalar::request_opts
          ) -> Scalar::Mcp::McpInstallation

          def retrieve: (
            String installation_id,
            id: String,
            ?request_options: Scalar::request_opts
          ) -> Scalar::Mcp::McpInstallation

          def update: (
            String installation_id,
            id: String,
            ?document_auth: ::Hash[Symbol, top],
            ?is_private: bool,
            ?login_portal_uid: String?,
            ?mcp_version: String?,
            ?name: String,
            ?slug: String,
            ?request_options: Scalar::request_opts
          ) -> Scalar::Mcp::McpInstallation

          def list: (
            String id,
            ?request_options: Scalar::request_opts
          ) -> ::Array[Scalar::Mcp::Servers::McpInstallationListItem]

          def delete: (
            String installation_id,
            id: String,
            ?request_options: Scalar::request_opts
          ) -> top

          def create_access_group: (
            String installation_id,
            id: String,
            access_group_uid: String,
            ?request_options: Scalar::request_opts
          ) -> top

          def delete_access_group: (
            String installation_id,
            id: String,
            access_group_uid: String,
            ?request_options: Scalar::request_opts
          ) -> top

          def initialize: (client: Scalar::Client) -> void
        end
      end
    end
  end
end
