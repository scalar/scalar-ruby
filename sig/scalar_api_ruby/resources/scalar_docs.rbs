module Scalar
  module Resources
    class ScalarDocs
      def create_guide: (
        allowed_domains: ::Array[String],
        allowed_users: ::Array[String],
        is_private: bool,
        name: String,
        ?slug: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocCreateGuideResponse

      def create_project: (
        name: String,
        provider: Scalar::Models::ScalarDocCreateProjectParams::provider,
        ?bitbucket_repository: Scalar::ScalarDocCreateProjectParams::BitbucketRepository,
        ?blank: bool,
        ?github_repository: Scalar::ScalarDocCreateProjectParams::GithubRepository,
        ?is_private: bool,
        ?slug: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::DocsProject

      def delete_project: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> top

      def list_guides: (
        ?request_options: Scalar::request_opts
      ) -> ::Array[Scalar::GithubProject]

      def list_project_config: (
        String slug,
        ?ref: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocListProjectConfigResponse

      def list_project_domain: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocListProjectDomainResponse

      def list_project_domain_status: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocListProjectDomainStatusResponse

      def list_projects: (
        ?limit: Integer,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocListProjectsResponse

      def publish_guide: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocPublishGuideResponse

      def publish_project: (
        String slug,
        ?commit_sha: String,
        ?config_path: String,
        ?preview: bool,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocPublishProjectResponse

      def retrieve_project: (
        String slug,
        ?request_options: Scalar::request_opts
      ) -> Scalar::DocsProject

      def update_project: (
        String slug,
        ?access_groups: ::Array[String],
        ?active_theme_id: String,
        ?agent_enabled: bool,
        ?analytics_enabled: bool,
        ?is_private: bool,
        ?login_portal_uid: Scalar::Models::ScalarDocUpdateProjectParams::login_portal_uid,
        ?name: String,
        ?request_options: Scalar::request_opts
      ) -> top

      def update_project_config: (
        String slug,
        content: String,
        ?base_token: String,
        ?message: String,
        ?path: String,
        ?ref: String,
        ?request_options: Scalar::request_opts
      ) -> Scalar::Models::ScalarDocUpdateProjectConfigResponse

      def initialize: (client: Scalar::Client) -> void
    end
  end
end
