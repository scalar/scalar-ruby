module Scalar
  module Resources
    class Teams
      class Invites
        def cancel: (String uid, ?request_options: Scalar::request_opts) -> top

        def member: (
          email: String,
          role: Scalar::Models::Teams::role,
          ?request_options: Scalar::request_opts
        ) -> top

        def resend: (String uid, ?request_options: Scalar::request_opts) -> top

        def initialize: (client: Scalar::Client) -> void
      end
    end
  end
end
